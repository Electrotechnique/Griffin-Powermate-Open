    EDITTEXT        1141, 350, 52, 76, 13, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        1161, 350, 52, 56, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", 1181, 410, 52, 16, 13
    LTEXT           "", 1102, 133, 72, 100, 8
    COMBOBOX        1122, 236, 70, 110, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        1142, 350, 70, 76, 13, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        1162, 350, 70, 56, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", 1182, 410, 70, 16, 13
    LTEXT           "", 1103, 133, 90, 100, 8
    COMBOBOX        1123, 236, 88, 110, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        1143, 350, 88, 76, 13, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        1163, 350, 88, 56, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", 1183, 410, 88, 16, 13
    LTEXT           "", 1104, 133, 108, 100, 8
    COMBOBOX        1124, 236, 106, 110, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        1144, 350, 106, 76, 13, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        1164, 350, 106, 56, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", 1184, 410, 106, 16, 13
    LTEXT           "", 1105, 133, 126, 100, 8
    COMBOBOX        1125, 236, 124, 110, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        1145, 350, 124, 76, 13, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        1165, 350, 124, 56, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", 1185, 410, 124, 16, 13
    LTEXT           "", 1106, 133, 144, 100, 8
    COMBOBOX        1126, 236, 142, 110, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        1146, 350, 142, 76, 13, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        1166, 350, 142, 56, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", 1186, 410, 142, 16, 13
    LTEXT           "", 1107, 133, 162, 100, 8
    COMBOBOX        1127, 236, 160, 110, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        1147, 350, 160, 76, 13, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        1167, 350, 160, 56, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", 1187, 410, 160, 16, 13
    LTEXT           "", 1108, 133, 180, 100, 8
    COMBOBOX        1128, 236, 178, 110, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        1148, 350, 178, 76, 13, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        1168, 350, 178, 56, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", 1188, 410, 178, 16, 13
    GROUPBOX        "General", -1, 7, 216, 426, 74
    LTEXT           "LED:", -1, 14, 231, 20, 8
    COMBOBOX        IDC_LED, 36, 229, 74, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Brightness:", -1, 120, 231, 40, 8
    CONTROL         "", IDC_BRIGHT, "msctls_trackbar32", TBS_NOTICKS | WS_TABSTOP, 160, 228, 100, 14
    AUTOCHECKBOX    "Pulse while muted", IDC_MUTEPULSE, 270, 230, 80, 10
    AUTOCHECKBOX    "Start with Windows", IDC_STARTUP, 355, 230, 76, 10
    LTEXT           "Long press (ms):", -1, 14, 251, 60, 8
    EDITTEXT        IDC_LONGMS, 76, 249, 30, 12, ES_NUMBER
    LTEXT           "Double click (ms):", -1, 116, 251, 64, 8
    EDITTEXT        IDC_DBLMS, 182, 249, 30, 12, ES_NUMBER
    LTEXT           "Detents per step:", -1, 222, 251, 62, 8
    EDITTEXT        IDC_SENS, 286, 249, 24, 12, ES_NUMBER
    LTEXT           "Fast-spin boost (x):", -1, 320, 251, 70, 8
    EDITTEXT        IDC_ACCEL, 392, 249, 24, 12, ES_NUMBER
    LTEXT           "Volume step (%):", -1, 14, 271, 60, 8
    EDITTEXT        IDC_VOLSTEP, 76, 269, 30, 12
    LTEXT           "Scroll amount:", -1, 116, 271, 64, 8
    EDITTEXT        IDC_SCROLLSTEP, 182, 269, 30, 12, ES_NUMBER
    AUTOCHECKBOX    "Invert scrolling", IDC_INVERT, 222, 270, 70, 10
    AUTOCHECKBOX    "Turning up unmutes", IDC_UNMUTE, 320, 270, 90, 10
    LTEXT           "Turn or press the PowerMate to see which action it triggers.", IDC_STATUS, 7, 302, 262, 8, SS_ENDELLIPSIS | SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 275, 298, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 329, 298, 50, 14
    PUSHBUTTON      "Apply", IDC_APPLY, 383, 298, 50, 14
END


VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ElectroTechnique"
      VALUE "FileDescription", "PowerMate for Windows"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "PowerMate"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "PowerMate.exe"
      VALUE "ProductName", "PowerMate for Windows"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
