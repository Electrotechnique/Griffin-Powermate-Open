#include <winver.h>
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_ON  ICON "../res/powermate.ico"
IDI_OFF ICON "../res/powermate-off.ico"
1 24 "app.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 440, 320
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "PowerMate Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Applications", -1, 7, 7, 112, 204
    LISTBOX         IDC_APPS, 14, 20, 98, 166, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Add...", IDC_ADD, 14, 190, 47, 14
    PUSHBUTTON      "Remove", IDC_REMOVE, 65, 190, 47, 14
    GROUPBOX        "Actions", IDC_ACTIONS_GRP, 126, 7, 307, 204
    LTEXT           "", IDC_HINT, 133, 19, 294, 10
    LTEXT           "", 1100, 133, 36, 100, 8
    COMBOBOX        1120, 236, 34, 110, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        1140, 350, 34, 76, 13, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT        1160, 350, 34, 56, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", 1180, 410, 34, 16, 13
    LTEXT           "", 1101, 133, 54, 100, 8
