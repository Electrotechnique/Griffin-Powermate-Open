#include <winver.h>
#include "resource.h"

IDI_ON  ICON "../res/powermate.ico"
IDI_OFF ICON "../res/powermate-off.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ElectroTechnique"
      VALUE "FileDescription", "PowerMate for Windows"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "PowerMate"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "PowerMate.exe"
      VALUE "ProductName", "PowerMate for Windows"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
